{
  "name": "stick-coach",
  "version": "0.2.0",
  "description": "GameCube controller stick analysis and PhobGCC calibration walkthroughs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.js\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "dist:linux": "tauri build --bundles appimage,deb"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
